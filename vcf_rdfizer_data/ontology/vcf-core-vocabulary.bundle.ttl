vcfc:SequenceAfterRightBracket a owl:NamedIndividual, vcfc:BreakendOrientation ;
  rdfs:label "sequence after right bracket"@en ; rdfs:comment "The ]p]t breakend form."@en .

vcfc:EventDeletion a owl:NamedIndividual, vcfc:EventType ; rdfs:label "DEL event type"@en ; vcfc:eventTypeCode "DEL" ; skos:exactMatch so:0000159 .
