?fv vcfc:declaredBy/vcfc:fieldId ?id ; vcfc:fieldValue ?raw . FILTER(REGEX(?id,"^(MEINFO|METRANS)$"))
BIND(IF(STR(?alt)=".",0,(STRLEN(STR(?alt)) - STRLEN(REPLACE(STR(?alt), ",", "")) + 1)) AS ?altCount)
FILTER(STR(?raw)!="." && (STRLEN(STR(?raw)) - STRLEN(REPLACE(STR(?raw), ",", "")) + 1) != 4)
}""" ] .

vcfc:VCF43Tuple4ItemsShape a sh:NodeShape ; sh:targetClass vcfc:VCFFile ;
  sh:sparql [ sh:message "VCFv4.3: parsed SV tuples must contain all value items." ;
