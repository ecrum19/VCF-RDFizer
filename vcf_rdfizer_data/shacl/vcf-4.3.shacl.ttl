PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
$this vcfc:fileFormat "VCFv4.3" ; vcfc:hasRecord ?record . ?record vcfc:hasAltAllele ?allele ; vcfc:hasCall/vcfc:hasInfoValue ?fv .
?fv vcfc:declaredBy/vcfc:fieldId ?id ; vcfc:fieldValue ?raw . FILTER(REGEX(?id,"^(MEINFO|METRANS)$"))
{ SELECT $this ?fv (COUNT(DISTINCT ?item) AS ?n) WHERE { ?fv vcfc:fieldValue ?raw . OPTIONAL { ?fv vcfc:hasValueItem ?item } } GROUP BY $this ?fv }
FILTER(?n != (STRLEN(STR(?raw)) - STRLEN(REPLACE(STR(?raw), ",", "")) + 1))
