PREFIX vcfr: <https://w3id.org/vcf-rdfizer/vocab#>

# Empty or whitespace-only terms.
#
# The pipeline should never materialize one. RML emits no triple for an empty
# reference, and every direct emitter either guards on a non-empty value or
# substitutes the VCF missing token, which becomes "."^^vcfr:Null. An empty
# literal therefore means a value was lost rather than marked missing, and an
# empty IRI means a template substitution collapsed.
#
# Whitespace-only counts as empty: a literal of spaces or tabs carries no more
# information than "" and is just as certainly a defect.
SELECT ?s ?p ?o ?issue
WHERE {
  ?s ?p ?o .
  BIND(
    IF(ISLITERAL(?o) && REGEX(STR(?o), "^\\s*$"), "EMPTY_LITERAL",
      IF(STR(?s) = "" || STR(?p) = "" || (ISIRI(?o) && STR(?o) = ""), "EMPTY_IRI", "")
    ) AS ?issue
  )
  FILTER(?issue != "")
}
LIMIT 100
