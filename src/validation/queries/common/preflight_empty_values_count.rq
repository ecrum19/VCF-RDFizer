PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>

# Exact number of triples carrying an empty or whitespace-only term.
SELECT (COUNT(*) AS ?anomalyCount)
WHERE {
  ?s ?p ?o .
  FILTER(
    (ISLITERAL(?o) && REGEX(STR(?o), "^\\s*$"))
    || STR(?s) = "" || STR(?p) = "" || (ISIRI(?o) && STR(?o) = "")
  )
}
