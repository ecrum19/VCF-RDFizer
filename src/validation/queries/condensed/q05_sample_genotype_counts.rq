PREFIX vcfr: <https://w3id.org/vcf-rdfizer/vocab#>

SELECT ?sampleId ?genotypeClass (COUNT(DISTINCT ?record) AS ?callCount)
WHERE {
  ?file a vcfr:VCFFile ; vcfr:hasRecord ?record ; vcfr:hasSampleSet ?sampleSet .
  ?record a vcfr:VCFRecord ; vcfr:hasCall ?call .
  ?sampleSet vcfr:hasSample ?sample .
  ?sample vcfr:sampleName ?sampleId ; vcfr:sampleIndex ?sampleIndex .
  OPTIONAL {
    ?sample vcfr:sampleIndex ?sampleIndexForVector .
    ?call vcfr:hasCallMatrix ?matrix .
    ?matrix vcfr:appliesToSampleSet ?sampleSet ; vcfr:hasFormatValueVector ?gtVector .
    ?gtVector vcfr:declaredBy ?definition ; vcfr:encodedValues ?encoded .
    ?definition vcfr:fieldId "GT" .
    BIND(?sampleIndexForVector - 1 AS ?zeroIndex)
    BIND(REPLACE(STR(?encoded), CONCAT("^(?:[^\\t]*\\t){", STR(?zeroIndex), "}([^\\t]*).*$"), "$1") AS ?gtLiteral)
  }
  BIND(IF(BOUND(?gtLiteral), REPLACE(STR(?gtLiteral), "[|]", "/"), "") AS ?gt)
  BIND(IF(!BOUND(?gtLiteral), "NO_GT_FIELD",
    IF(CONTAINS(?gt, "."), "MISSING",
      IF(REGEX(?gt, "^[0-9]+$"), IF(?gt = "0", "HAPLOID_REF", "HAPLOID_ALT"),
        IF(REGEX(?gt, "^[0-9]+/[0-9]+$"),
          IF(STRBEFORE(?gt, "/") = STRAFTER(?gt, "/"), IF(STRBEFORE(?gt, "/") = "0", "HOM_REF", "HOM_ALT"), "HET"),
          "OTHER_PLOIDY")))) AS ?genotypeClass)
}
GROUP BY ?sampleId ?genotypeClass
ORDER BY ?sampleId ?genotypeClass
