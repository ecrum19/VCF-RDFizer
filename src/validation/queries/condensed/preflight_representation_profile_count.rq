PREFIX vcfc: <https://w3id.org/vcf-core/vocab#>

# Exact number of VCFFile resources not declaring the condensed profile.
SELECT (COUNT(*) AS ?anomalyCount)
WHERE {
  ?file a vcfc:VCFFile .
  OPTIONAL { ?file vcfc:representationProfile ?profile }
  FILTER(!BOUND(?profile) || ?profile != vcfc:CondensedRepresentation)
}
